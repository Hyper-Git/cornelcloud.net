        <mxCell id="step-1-desc-l" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;DNS Resolution&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;User visits cornelcloud.net. Route 53 resolves the domain to the CloudFront distribution via an A/AAAA alias record.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="1">
          <mxGeometry x="1450" y="100" width="520" height="70" as="geometry" />
        </mxCell>
        <mxCell id="step-2-badge-l" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="2" vertex="1" parent="1">
          <mxGeometry x="1400" y="185" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="step-2-desc-l" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;CDN + TLS Termination&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;CloudFront serves the site over HTTPS using an ACM certificate (us-east-1). PriceClass_100 covers US, Canada, and Europe.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="1">
          <mxGeometry x="1450" y="185" width="520" height="70" as="geometry" />
        </mxCell>
        <mxCell id="step-3-badge-l" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="3" vertex="1" parent="1">
          <mxGeometry x="1400" y="270" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="step-3-desc-l" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Static Asset Delivery&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;CloudFront fetches assets from S3 via Origin Access Control (SigV4 signing). The S3 bucket is fully private with SSE-S3 encryption.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="1">
          <mxGeometry x="1450" y="270" width="520" height="70" as="geometry" />
        </mxCell>
        <mxCell id="step-4-badge-l" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="4" vertex="1" parent="1">
          <mxGeometry x="1400" y="355" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="step-4-desc-l" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Terraform State Backend&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;A separate S3 bucket (cornel-terraform-bucket) stores encrypted Terraform state for the portfolio infrastructure.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="1">
          <mxGeometry x="1450" y="355" width="520" height="70" as="geometry" />
        </mxCell>
        <mxCell id="step-5-badge-l" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="5" vertex="1" parent="1">
          <mxGeometry x="1400" y="440" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="step-5-desc-l" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;API Entry Point&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;API Gateway v2 (HTTP API) receives POST /contact and POST /chat requests from the browser. CORS is configured for cornelcloud.net.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="1">
          <mxGeometry x="1450" y="440" width="520" height="70" as="geometry" />
        </mxCell>
        <mxCell id="step-6a-badge-l" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="6a" vertex="1" parent="1">
          <mxGeometry x="1400" y="525" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="step-6a-desc-l" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Contact Form Handler&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Lambda (Python 3.12) validates and sanitises the form input, then invokes SES to send an email to contact@cornelcloud.net.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="1">
          <mxGeometry x="1450" y="525" width="520" height="70" as="geometry" />
        </mxCell>
        <mxCell id="step-6b-badge-l" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="6b" vertex="1" parent="1">
          <mxGeometry x="1400" y="610" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="step-6b-desc-l" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Chatbot Handler&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Lambda (Python 3.12, 30s timeout) loads conversation history from DynamoDB, then calls Amazon Bedrock with the full message thread.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="1">
          <mxGeometry x="1450" y="610" width="520" height="70" as="geometry" />
        </mxCell>
        <mxCell id="step-7a-badge-l" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="7a" vertex="1" parent="1">
          <mxGeometry x="1400" y="695" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="step-7a-desc-l" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Email Delivery&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;SES sends the contact form email from noreply@cornelcloud.net to contact@cornelcloud.net using a verified domain identity.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="1">
          <mxGeometry x="1450" y="695" width="520" height="70" as="geometry" />
        </mxCell>
        <mxCell id="step-7b-badge-l" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="7b" vertex="1" parent="1">
          <mxGeometry x="1400" y="770" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="step-7b-desc-l" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;AI Inference&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Bedrock invokes Claude Opus 4.5 via the eu-west-1 cross-region inference profile. The response is saved back to DynamoDB (step 8) with a 24h TTL.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="1">
          <mxGeometry x="1450" y="770" width="520" height="70" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
